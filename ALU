    return 0;
}
void bit1ALU(bool a, bool b, bool ENA, bool ENB, bool Cin, bool M0, bool M1, bool& Out, bool& Cout)
{
    bool rez1, rez2, rez3, rez4;
    bool sum;
    a = AND(a, ENA);
    b = AND(b, ENB);
    rez1 = NOT(a);
    rez2 = NOT(b);
    rez3 = XOR(a, b);
    Fadder(a, b, Cin, Cout, sum);
    rez4 = sum;
    MUX(rez1, rez2, rez3, rez4, M0, M1, Out, Cout);
}
void Shifter(bool A[8], bool Cntr)
{
    bool temp[8];
    temp[0] = AND(A[1], Cntr);
    temp[1] = OR(AND(A[2], Cntr), AND(A[0], NOT(Cntr)));
    temp[2] = OR(AND(A[3], Cntr), AND(A[1], NOT(Cntr)));
    temp[3] = OR(AND(A[4], Cntr), AND(A[2], NOT(Cntr)));
    temp[4] = OR(AND(A[5], Cntr), AND(A[3], NOT(Cntr)));
    temp[5] = OR(AND(A[6], Cntr), AND(A[4], NOT(Cntr)));
    temp[6] = OR(AND(A[7], Cntr), AND(A[5], NOT(Cntr)));
    temp[7] = AND(A[6], NOT(Cntr));
    for (int i = 0; i < 8; i++)
        A[i] = temp[i];
}
void MUX(bool rez1, bool rez2, bool rez3, bool rez4, bool M0, bool M1, bool& Out, bool& Cout)
{
    bool and1, and2, and3, and4;
    and1 = AND(AND(rez1, NOT(M0)), NOT(M1));
    and2 = AND(AND(rez2, NOT(M0)), M1);
    and3 = AND(AND(rez3, M0), NOT(M1));
    and4 = AND(AND(rez4, M0), M1);
    Out = OR(OR(and1, and2), OR(and3, and4));
}
void dekoderis(bool D[3], bool dekod[8])
{
    dekod[0] = AND(AND(NOT(D[0]), NOT(D[1])), NOT(D[2]));
    dekod[1] = AND(AND(NOT(D[0]), NOT(D[1])), D[2]);
    dekod[2] = AND(AND(NOT(D[0]), D[1]), NOT(D[2]));
    dekod[3] = AND(AND(NOT(D[0]), D[1]), D[2]);
    dekod[4] = AND(AND(D[0], NOT(D[1])), NOT(D[2]));
    dekod[5] = AND(AND(D[0], NOT(D[1])), D[2]);
    dekod[6] = AND(AND(D[0], D[1]), NOT(D[2]));
    dekod[7] = AND(AND(D[0], D[1]), D[2]);

}
void Fadder(bool a, bool b, bool Cin, bool& Cout, bool& sum)//cia dar reik suma padaryt
{
    bool carry1 = 0, carry2 = 0, sum1, sum2;
    Hadder(a, b, carry1, sum1);
    Hadder(sum1, Cin, carry2, sum2);
    sum = sum2;
    Cout = OR(carry1, carry2);
}
void Hadder(bool a, bool b, bool& carry, bool& sum)
{
    sum = XOR(a, b);
    carry = AND(a, b);
}
bool NAND(bool a, bool b)
{
    return !(a * b);
}
bool NOT(bool a)
{
    return NAND(a, a);
}
bool OR(bool a, bool b)
{
    return NAND(NAND(a, a), NAND(b, b));
}
bool AND(bool a, bool b)
{
    return NAND(NAND(a, b), NAND(a, b));
}
bool XOR(bool a, bool b)
{
    bool ab;
    ab = NAND(a, b);
    return NAND(NAND(a, ab), NAND(b, ab));
}
bool NOR(bool a, bool b)
{
    return NAND(NAND(NAND(a, a), NAND(b, b)), NAND(NAND(a, a), NAND(b, b)));
}
