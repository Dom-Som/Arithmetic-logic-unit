        for (int i = 0; i < 8; i++)
        {
            bit1ALU(A[i], B[i], ENA, ENB, Cin, M0, M1, Out, Cout);
            ats[i] = Out;
        }
        ATS = NOT(OR(OR(OR(ats[0], ats[1]), OR(ats[2], ats[3])), OR(OR(ats[4], ats[5]), OR(ats[6], ats[7]))));
        cout << ATS;
    }
    if (dekod[3] == 1)//Dekoderis kai skaicius reikia sudeti
    {
        M0 = 1; M1 = 1;
        for (int i = 7; i >= 0; i--)
        {
            Cin = Cout;
            bit1ALU(A[i], B[i], ENA, ENB, Cin, M0, M1, Out, Cout);
            ats[i] = Out;

        }
