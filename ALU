    if (dekod[4] == 1)//Dekoderis kai skaicius reikia sudauginti
    {
        bool ats[8]{0,0,0,0,0,0,0,0};
        while (OR(OR(OR(B[0], B[1]), OR(B[2], B[3])), OR(OR(B[4], B[5]), OR(B[6], B[7])))==1)
        {
